    "observed_only",
    "not_verified",
    "observed_refs",
    "ci_run",
    "checks",
    "ignored_commit_statuses",
    "issues",
    "evidence_complete",
    "observation_state"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:geointel:pr-evidence:v1",
  "title": "Advisory PR metadata observation; never approval or merge readiness",
  "$defs": {
    "state": {
      "enum": [
        "success",
        "failure",
        "pending",
        "skipped",
        "unknown"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "issues": {
            "maxItems": 0
          },
          "observation_state": {
            "const": "success"
          },
          "checks": {
            "items": {
              "properties": {
                "state": {
                  "const": "success"
                }
              }
            }
          }
        }
      }
    }
  ]
}
